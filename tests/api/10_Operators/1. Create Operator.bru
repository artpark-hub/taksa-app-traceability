meta {
  name: 1. Create Operator
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/operators
  body: json
  auth: none
}

body:json {
{
    "operator_id": "OP-TEST-1773048307",
    "name": "Test Operator",
    "role": "Quality Control",
    "shift": "DAY_SHIFT"
  }
}

assert {
  res.status: eq 200
}
