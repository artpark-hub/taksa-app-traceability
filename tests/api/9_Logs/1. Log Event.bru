meta {
  name: 1. Log Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/logs
  body: json
  auth: none
}

body:json {
  {
    "equipment_id": "ROBOT-99",
    "event_type": "Production Start",
    "work_order_id": "WO-2025-001"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}
