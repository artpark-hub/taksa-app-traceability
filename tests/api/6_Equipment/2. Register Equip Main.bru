meta {
  name: 2. Register Equip Main
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/traceability/equipment
  body: json
  auth: none
}

body:json {
  {
    "id": "ROBOT-99",
    "physical_asset_id": "SN-9988",
    "production_unit_id": 1,
    "equipment_class_id": 1,
    "operational_status": "Idle"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq "ROBOT-99"
}
