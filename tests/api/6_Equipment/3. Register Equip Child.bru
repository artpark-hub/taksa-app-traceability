meta {
  name: 3. Register Equip Child
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/traceability/equipment
  body: json
  auth: none
}

body:json {
  {
    "id": "SENSOR-01",
    "physical_asset_id": "SN-SENS-001",
    "production_unit_id": 1,
    "equipment_class_id": 1,
    "operational_status": "Running",
    "parent_equipment_id": "ROBOT-99"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq "SENSOR-01"
}
