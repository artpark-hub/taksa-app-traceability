meta {
  name: 1. Create Definition
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/material-definitions
  body: json
  auth: none
}

body:json {
{
    "name": "Raw Silicon",
    "material_type": "RAW_MATERIAL",
    "unit_of_measure": "kg"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  bru.setVar("defId", res.body.id);
}
