meta {
  name: 1. Create Site
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/sites
  body: json
  auth: none
}

body:json {
  {
    "enterprise_id": 1,
    "name": "Detroit Plant",
    "location": "Michigan, USA"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}
