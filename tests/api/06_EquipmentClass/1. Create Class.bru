meta {
  name: 1. Create Class
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/equipment-classes
  body: json
  auth: none
}

body:json {
{
    "class_name": "Kuka Robot",
    "version": "v2.0"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  bru.setVar("classId", res.body.id);
}
