meta {
  name: 1. Create Area
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/areas
  body: json
  auth: none
}

body:json {
{
    "site_id": {{siteId}},
    "name": "Body Shop",
    "description": "Welding Area"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}

script:post-response {
  bru.setVar("areaId", res.body.id);
}
