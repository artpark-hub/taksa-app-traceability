meta {
  name: 2. Compare Machines
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/traceability/analytics/machine-comparison
  body: json
  auth: none
}

body:json {
{
    "equipment_ids": ["MIXER-001", "OVEN-001", "ROBOT-001"],
