meta {
  name: 1. Add Capability
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/traceability/equipment/ROBOT-99/capabilities
  body: json
  auth: none
}

body:json {
  {
    "capability_name": "Max Load",
    "value": "100",
    "uom": "kg"
  }
}

assert {
  res.status: eq 200
  res.body.id: isNumber
}
